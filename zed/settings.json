// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "cli_default_open_behavior": "existing_window",
    "git": {
        "diff_base": "head"
    },
    "use_autoclose": false,
    "diagnostics": {
        "button": true,
    },
    "project_panel": {
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
        "button": false,
    },
    "disable_ai": true,
    "agent": {
        "dock": "right",
        "favorite_models": [],
        "model_parameters": [],
    },
    "git_panel": {
        "dock": "left",
    },
    "ui_font_family": ".SystemUIFont",
    "buffer_font_weight": 400.0,
    "buffer_font_family": "Cascadia Mono",
    "vim_mode": true,
    "vim": {
        "use_system_clipboard": "never",
    },
    "which_key": { "enabled": true, "delay_ms": 700 },
    "terminal": {
        "font_family": "Cascadia Mono",
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "base_keymap": "VSCode",
    "preview_tabs": {
        "enabled": true,
    },
    "tab_bar": {
        "show": true,
    },
    "relative_line_numbers": "enabled",
    "vertical_scroll_margin": 10.0,
    "gutter": {
        "line_numbers": true,
    },
    "minimap": {
        "show": "always",
    },
    "file_types": {},
    "wrap_guides": [80, 88],
    "hard_tabs": false,
    "tab_size": 4,
    "ui_font_size": 16,
    "buffer_font_size": 12.5,
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "One Dark",
    },
    "languages": {
        "JSON": {
            "use_autoclose": true,
        },
        "reST": {
            "language_servers": ["esbonio"],
        },
        "Python": {
            "preferred_line_length": 88,
            "language_servers": [
                "ty",
                "ruff",
                "!pyright",
                "!basedpyright",
                "!pylsp",
            ],
            "formatter": "language_server",
            "format_on_save": "on",
        },
        "Markdown": {
            "prettier": {
                "allowed": true,
                "proseWrap": "always",
            },
            "format_on_save": "off",
        },
    },
    "lsp": {
        "esbonio": {
            "binary": {
                "path": ".venv/Scripts/esbonio",
                "arguments": ["server"],
            },
            "settings": {
                "esbonio": {
                    "sphinx": {
                        "confDir": "docs/source",
                    },
                },
            },
        },
    },
}
