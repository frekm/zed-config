// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "context": "Workspace",
        "bindings": {
            // "shift shift": "file_finder::Toggle"
            "ctrl-f5": [
                "task::Spawn",
                {
                    "task_name": "Run Python with uv",
                    "reevaluate_context": true,
                },
            ],
            "ctrl-1": ["workspace::ActivatePane", 0],
            "ctrl-2": ["workspace::ActivatePane", 1],
            "ctrl-3": ["workspace::ActivatePane", 2],
            "ctrl-4": ["workspace::ActivatePane", 3],
            "ctrl-5": ["workspace::ActivatePane", 4],
            "ctrl-6": ["workspace::ActivatePane", 5],
            "ctrl-7": ["workspace::ActivatePane", 6],
            "ctrl-8": ["workspace::ActivatePane", 7],
            "ctrl-9": ["workspace::ActivatePane", 8],
            "ctrl-o": "project_panel::ToggleFocus",
            "ctrl-g": "git_panel::ToggleFocus",
            "ctrl-e": "editor::ToggleFocus",
        },
    },
    {
        "context": "vim_mode == insert",
        "bindings": {
            "ctrl-v": "editor::Paste",
        },
    },
    {
        "context": "Editor",
        "bindings": {
            "ctrl-k ctrl-u": "editor::ToggleComments",
        },
    },
    {
        "context": "VimControl && !menu",
        "unbind": {
            "ctrl-g": "vim::ShowLocation"
        }
    },
    {
        "context": "Editor && vim_mode == insert",
        "bindings": {
            // "j k": "vim::NormalBefore"
        },
    },
    {
        "context": "Editor && vim_mode == normal",
        "bindings": {
            "space f d": "editor::GoToDefinition",
            "space n a": "editor::GoToDiagnostic",
            "space r": "editor::Rename",
            "space h": "editor::Hover",
            "space f f": "editor::Format",
            "ctrl-o": "pane::RevealInProjectPanel",
        },
    },
    {
        "unbind": {
            "ctrl-o": "workspace::OpenFiles",
        },
    },
    {
        "context": "Terminal",
        "unbind": {
            "ctrl-o": ["terminal::SendKeystroke", "ctrl-o"],
        },
        "bindings": {
            "ctrl-ö": "editor::ToggleFocus",
        },
    },
    {
        "context": "Pane",
        "bindings": {
            "ctrl+alt+left": "pane::ActivateLastItem",
            "ctrl+alt+right": "pane::ActivatePreviousItem",
        },
    },
    {
        "context": "Pane",
        "bindings": {
            "alt-left": "pane::ActivatePreviousItem",
            "alt-right": "pane::ActivateNextItem",
        },
    },
    {
        "context": "Editor && mode == full",
        "unbind": {
            "ctrl-g": "go_to_line::Toggle",
        },
    },
    {
        "context": "ThreadsSidebar",
        "unbind": {
            "ctrl-g": "agents_sidebar::ToggleThreadHistory",
        },
    },
    {
        "context": "Workspace",
        "unbind": {
            "ctrl-shift-n": "workspace::NewWindow",
        },
    },
    {
        "context": "!ProjectPanel",
        "bindings": {
            "ctrl-shift-n": "workspace::NewWindow",
        },
    },
    {
        "context": "ProjectPanel",
        "bindings": {
            "ctrl-shift-n": "project_panel::NewDirectory",
        },
    },
    {
        "context": "MarkdownPreview",
        "unbind": {
            "ctrl-e": "markdown::ScrollDown"
        }
    },
    {
        "context": "VimControl && !menu",
        "unbind": {
            "ctrl-e": "vim::LineDown"
        }
    },
    {
        "context": "showing_completions",
        "unbind": {
            "ctrl-e": "vim::LineDown"
        }
    },
    {
        "context": "Workspace",
        "unbind": {
            "ctrl-e": "file_finder::Toggle"
        }
    },
    {
        "context": "Terminal",
        "unbind": {
            "ctrl-e": [
                "terminal::SendKeystroke",
                "ctrl-e"
            ]
        }
    },
    {
        "context": "KeymapEditor",
        "unbind": {
            "ctrl-e": "zed::OpenKeymapFile"
        }
    }
]
